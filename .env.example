# =========================================================
# Brixel ERP — Environment Configuration
# =========================================================
# Copy this to .env and adjust values for your environment.
# Docker setup.sh does this automatically.
# =========================================================

APP_NAME="Brixel ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8090
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# =========================================================
# PostgreSQL (Docker: brixel_erp_postgres)
# =========================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp_app
DB_USERNAME=erp_app
DB_PASSWORD=erp_app_password

# =========================================================
# Redis (Docker: brixel_erp_redis)
# =========================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================================================
# Cache, Sessions & Queue
# =========================================================
CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# =========================================================
# Broadcasting (Laravel Reverb WebSockets)
# =========================================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=erp-local
REVERB_APP_KEY=erp-reverb-key
REVERB_APP_SECRET=erp-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =========================================================
# Filesystem
# =========================================================
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =========================================================
# Mail
# =========================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@brixelltd.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================
# Logging
# =========================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================
# Frontend (Vite / React / DevExpress)
# =========================================================
VITE_APP_NAME="${APP_NAME}"

# =========================================================
# Docker Port Mappings (host ports)
# =========================================================
ERP_HTTP_PORT=8090
ERP_HTTPS_PORT=8450
ERP_DB_PORT=35432
ERP_REDIS_PORT=36379
ERP_REVERB_PORT=38080
ERP_VITE_PORT=5173

# =========================================================
# SaaS / Multi-Tenancy
# =========================================================
TENANT_DOMAIN_SUFFIX=erp.brixelltd.com

# =========================================================
# Integrations (configure per deployment)
# =========================================================
# FBR / e-Invoicing
FBR_PROVIDER=
FBR_API_URL=
FBR_API_KEY=

# SMS Provider
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=

# WhatsApp Provider
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Payment Gateway
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# =========================================================
# ERP policy defaults
# =========================================================
ERP_ALLOW_NEGATIVE_STOCK=false

# DevExtreme (DevExpress) licence key — without it the UI runs in trial mode
VITE_DEVEXTREME_LICENSE_KEY=
